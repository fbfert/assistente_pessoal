# =============================================================================
# TARS piloto — variáveis de ambiente
# Copie para .env e preencha. O .env NUNCA entra no Git.
# =============================================================================

# --- LLM: chave, modelo e provedor --------------------------------------------
# TUDO NESTA SEÇÃO TAMBÉM SE CONFIGURA PELA TELA, em /credenciais no admin.
#
# O que estiver configurado lá tem precedência sobre o que estiver aqui; faltando
# lá, vale o daqui. Estas variáveis continuam funcionando exatamente como sempre
# funcionaram — ninguém é obrigado a migrar, e nada aqui precisa ser removido.
#
# A diferença prática: trocar pela tela vale sem reiniciar container nenhum, e a
# alteração fica auditada com autor e data. Trocar aqui exige editar o arquivo no
# servidor e subir os containers de novo.
#
# Onde a tela grava: /data/llm-chaves.json, dentro do volume tars_data. RECRIAR O
# VOLUME APAGA AQUILO — o que estiver neste arquivo é o que sobrevive.

# Valores aceitos: claude | openai | deepseek
# Também é o rádio "provedor ativo na conversa" em /credenciais.
LLM_PROVIDER=claude

# Chave da Anthropic (provedor "claude"). https://console.anthropic.com/
# Também colável em /credenciais — lá ela nunca é exibida de volta.
ANTHROPIC_API_KEY=
# Modelo Claude usado nas respostas ao usuário.
ANTHROPIC_MODEL=claude-sonnet-5

# Chave da OpenAI (provedor "openai" E transcrição de áudio, sempre).
# Uma chave só para os dois usos — a transcrição não tem credencial separada.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Chave da DeepSeek (provedor "deepseek"). https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Transcrição de áudio ----------------------------------------------------
# Usa sempre a OpenAI, independente de LLM_PROVIDER. Precisa de OPENAI_API_KEY.
# Trocar o provedor ativo da conversa NÃO muda isto.
#
# O modelo também se escolhe em /credenciais, na seção da OpenAI (mesma
# precedência: a tela primeiro, esta variável depois).
TRANSCRIPTION_MODEL=gpt-4o-transcribe
TRANSCRIPTION_LANGUAGE=pt

# --- Canal web (segundo canal, reativo) --------------------------------------
# A página de conversa por navegador, servida pelo MESMO processo do bot.
# Só responde quando alguém escreve: gatilho e lembrete continuam só no WhatsApp.
#
# Porta publicada apenas no loopback do host (como o dashboard). Alcançar de fora
# exige entrada no proxy reverso do Apache, que não vive neste repositório.
WEB_PORT=3400

# Interface em que o processo escuta. Deixe 127.0.0.1 ao rodar direto no host.
# No Docker isto vira 0.0.0.0 (definido no docker-compose.yml): dentro do
# container o 127.0.0.1 é inalcançável pelo mapeamento de porta.
WEB_HOST=127.0.0.1

# Inatividade até a sessão web expirar. Expirar NÃO apaga conversa — só exige
# entrar de novo com telefone e data de nascimento.
WEB_SESSAO_HORAS=6

# Proteção da entrada pública contra força bruta. As duas contagens valem ao
# mesmo tempo: por origem e por telefone.
WEB_MAX_TENTATIVAS=5
WEB_BLOQUEIO_MINUTOS=15

# Atraso fixo a cada tentativa malsucedida, em milissegundos. É a defesa que não
# se contorna, por não depender de identificar quem tentou. Baixar isto
# enfraquece o sistema de verdade — existe configurável por causa da suíte.
WEB_ATRASO_FALHA_MS=1000

# --- Fuso horário ------------------------------------------------------------
# O scheduler calcula a hora de São Paulo explicitamente e não confia nesta
# variável, mas ela mantém logs e timestamps coerentes.
TZ=America/Sao_Paulo

# --- Banco de dados ----------------------------------------------------------
# No Docker isto é sobrescrito para /data/tars.sqlite (volume nomeado).
DB_PATH=./data/tars.sqlite

# --- WhatsApp ----------------------------------------------------------------
# Diretório da sessão pareada (Baileys, useMultiFileAuthState).
# Perder este diretório significa parear de novo, presencialmente com o chip.
# No Docker isto é sobrescrito para /data/auth.
WHATSAPP_AUTH_DIR=./auth

# --- Dashboard ---------------------------------------------------------------
# Escuta SOMENTE em 127.0.0.1. Acesso remoto é por túnel SSH:
#   ssh -L 3300:localhost:3300 usuario@<ip-do-servidor>
DASHBOARD_PORT=3300

# Interface em que o processo escuta. Deixe 127.0.0.1 ao rodar direto no host.
# No Docker isto vira 0.0.0.0 (definido no docker-compose.yml): dentro do
# container o 127.0.0.1 é inalcançável pelo mapeamento de porta, e quem garante
# o loopback passa a ser o bind "127.0.0.1:3300:3300" do Compose.
DASHBOARD_HOST=127.0.0.1

# --- Backend administrativo --------------------------------------------------
# O login e por E-MAIL + SENHA, com contas na tabela admin_usuarios.
#
# As duas variaveis abaixo sao a SEMENTE DO BOOTSTRAP: na primeira subida, se
# nao houver nenhuma conta, uma e criada com elas. Depois disso ADMIN_PASSWORD
# NAO e mais aceita no login -- entrar passa a ser pela senha da conta, que se
# troca em /conta.
#
# O admin permite EDITAR dado de saude de pessoas identificadas e exibe o
# historico completo das conversas. O bind em loopback protege contra a rede;
# a conta protege contra quem ja esta do lado de dentro do tunel, e diz QUEM
# fez cada alteracao.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_PASSWORD=

# --- Números "no chute", calibráveis pelo piloto -----------------------------
# Janela, em minutos, para uma mensagem contar como resposta ao último gatilho.
# Fora dela, a mensagem é classificada como despejo espontâneo.
# O limite é INCLUSIVO: exatamente 120 min ainda conta como resposta.
RESPOSTA_GATILHO_JANELA_MIN=120

# Silêncios consecutivos do MESMO tipo de gatilho até o tom ficar mais curto e
# menos exigente. O sistema NUNCA intensifica a cobrança em quem está sumindo.
SILENCIOS_ATE_REDUZIR_TOM=3
