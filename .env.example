# =============================================================================
# TARS piloto — variáveis de ambiente
# Copie para .env e preencha. O .env NUNCA entra no Git.
# =============================================================================

# --- LLM: qual provedor usar -------------------------------------------------
# Valores aceitos: claude | openai | deepseek
# Trocar aqui troca o provedor sem nenhuma alteração de código.
LLM_PROVIDER=claude

# Chave da Anthropic (provedor "claude"). https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Modelo Claude usado nas respostas ao usuário.
ANTHROPIC_MODEL=claude-sonnet-5

# Chave da OpenAI (provedor "openai" E transcrição de áudio, sempre).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Chave da DeepSeek (provedor "deepseek"). https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Transcrição de áudio ----------------------------------------------------
# Usa sempre a OpenAI, independente de LLM_PROVIDER. Precisa de OPENAI_API_KEY.
TRANSCRIPTION_MODEL=gpt-4o-transcribe
TRANSCRIPTION_LANGUAGE=pt

# --- Fuso horário ------------------------------------------------------------
# O scheduler calcula a hora de São Paulo explicitamente e não confia nesta
# variável, mas ela mantém logs e timestamps coerentes.
TZ=America/Sao_Paulo

# --- Banco de dados ----------------------------------------------------------
# No Docker isto é sobrescrito para /data/tars.sqlite (volume nomeado).
DB_PATH=./data/tars.sqlite

# --- WhatsApp ----------------------------------------------------------------
# Diretório da sessão pareada (Baileys, useMultiFileAuthState).
# Perder este diretório significa parear de novo, presencialmente com o chip.
# No Docker isto é sobrescrito para /data/auth.
WHATSAPP_AUTH_DIR=./auth

# --- Dashboard ---------------------------------------------------------------
# Escuta SOMENTE em 127.0.0.1. Acesso remoto é por túnel SSH:
#   ssh -L 3300:localhost:3300 usuario@<ip-do-servidor>
DASHBOARD_PORT=3300

# Interface em que o processo escuta. Deixe 127.0.0.1 ao rodar direto no host.
# No Docker isto vira 0.0.0.0 (definido no docker-compose.yml): dentro do
# container o 127.0.0.1 é inalcançável pelo mapeamento de porta, e quem garante
# o loopback passa a ser o bind "127.0.0.1:3300:3300" do Compose.
DASHBOARD_HOST=127.0.0.1

# --- Números "no chute", calibráveis pelo piloto -----------------------------
# Janela, em minutos, para uma mensagem contar como resposta ao último gatilho.
# Fora dela, a mensagem é classificada como despejo espontâneo.
# O limite é INCLUSIVO: exatamente 120 min ainda conta como resposta.
RESPOSTA_GATILHO_JANELA_MIN=120

# Silêncios consecutivos do MESMO tipo de gatilho até o tom ficar mais curto e
# menos exigente. O sistema NUNCA intensifica a cobrança em quem está sumindo.
SILENCIOS_ATE_REDUZIR_TOM=3
